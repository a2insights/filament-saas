{
    "name": "a2insights/filament-saas",
    "description": "Filament Saas for A2Insights",
    "keywords": [
        "laravel",
        "filament",
        "a2insights",
        "filament-saas"
    ],
    "homepage": "https://github.com/a2insights/filament-saas",
    "support": {
        "issues": "https://github.com/a2insights/filament-saas/issues",
        "source": "https://github.com/a2insights/filament-saas"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "a21ns1g4ts",
            "email": "atila.danvi@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "amidesfahani/filament-tinyeditor": "^5.0",
        "artesaos/seotools": "^1.3",
        "awcodes/filament-quick-create": "^5.0",
        "awcodes/palette": "^3.0",
        "bezhansalleh/filament-shield": "4.2.0",
        "blade-ui-kit/blade-heroicons": "^2.6",
        "blade-ui-kit/blade-icons": "^1.8",
        "codeat3/blade-iconpark": "^1.7",
        "filament/filament": "^5.0",
        "filament/notifications": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "filament/spatie-laravel-settings-plugin": "^5.0",
        "filament/tables": "^5.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "jeffgreco13/filament-breezy": "^3.2",
        "joaopaulolndev/filament-pdf-viewer": "^3.0",
        "kenepa/banner": "^1.0",
        "laravel/sanctum": "^4.2",
        "league/flysystem-aws-s3-v3": "^3.29",
        "livewire/livewire": "^4.1",
        "malzariey/filament-daterangepicker-filter": "^5.0",
        "marjose123/filament-webhook-server": "^3.0",
        "opcodesio/log-viewer": "^3.19",
        "pxlrbt/filament-environment-indicator": "^3.1",
        "pxlrbt/filament-spotlight": "^2.0",
        "ralphjsmit/laravel-seo": "^1.7",
        "spatie/laravel-data": "^4.17",
        "spatie/laravel-enum": "^3.2",
        "spatie/laravel-package-tools": "^1.92",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/laravel-stats": "^2.1",
        "symfony/intl": "^7.2",
        "taylornetwork/laravel-username-generator": "^2.8",
        "ysfkaya/filament-phone-input": "4.2.3",
        "secondnetwork/blade-tabler-icons": "^3.35",
        "davidhsianturi/blade-bootstrap-icons": "^2.1",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "spykapps/theme-aberdeen": "^1.0",
        "spykapps/theme-edinburgh": "^1.0",
        "spykapps/theme-inverness": "^1.0",
        "filafly/brisk": "^1.1",
        "caresome/filament-neobrutalism-theme": "^2.1",
        "bezhansalleh/filament-panel-switch": "^3.1"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "nunomaduro/collision": "^8.2.2",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "brianium/paratest": "^7.3",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "A2Insights\\FilamentSaas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "A2Insights\\FilamentSaas\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": [
            "rector",
            "pint",
            "npm run prettier"
        ],
        "pint": "pint --config pint-strict-imports.json",
        "rector": "rector",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit 2G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "audit": {
            "block-insecure": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "A2Insights\\FilamentSaas\\FilamentSaasServiceProvider"
            ],
            "aliases": {
                "FilamentSaas": "A2Insights\\FilamentSaas\\Facades\\FilamentSaas"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
